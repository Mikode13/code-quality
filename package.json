{
	"name": "@mikode13/code-quality",
	"version": "0.0.0-development",
	"description": "Shared ESLint code-quality configuration for MiKode projects.",
	"type": "module",
	"packageManager": "pnpm@11.17.0",
	"engines": {
		"node": "^22.13.0 || ^24.0.0"
	},
	"exports": {
		"./base": "./src/base.js",
		"./react": "./src/react.js"
	},
	"files": [
		"src"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Mikode13/code-quality.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "SEE LICENSE IN LICENSE",
	"scripts": {
		"prepare": "mikode-git-hooks install",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tests && node --check src/base.js && node --check src/react.js && node --check eslint.config.js && node --check prettier.config.mjs",
		"test": "pnpm run test:integration",
		"test:integration": "vitest run --project integration",
		"check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
		"audit:prod": "pnpm audit --prod",
		"pack:check": "node scripts/pack-check.mjs"
	},
	"dependencies": {
		"@eslint-react/eslint-plugin": "5.18.0",
		"@eslint/js": "10.0.1",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-jsx-a11y-x": "0.2.0",
		"eslint-plugin-react-hooks": "7.1.1",
		"globals": "17.7.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.65.0"
	},
	"peerDependencies": {
		"eslint": "^10.8.0"
	},
	"devDependencies": {
		"@mikode13/code-style": "0.1.0",
		"@mikode13/git-hooks": "0.1.0",
		"@mikode13/tsconfig": "0.1.0",
		"@types/node": "24.13.3",
		"@types/react": "19.2.17",
		"eslint": "10.8.0",
		"prettier": "3.9.6",
		"react": "19.2.8",
		"vitest": "4.1.10"
	}
}
